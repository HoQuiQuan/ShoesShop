// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String?
  status    String  // kiem tra xem user co dang hoat dong hay khong
  createdAt DateTime @default(now())
  avarta    String?
  updateAt  DateTime?
  provider  String
  role      String
  orders    Orders[]
  comments  Comments[]
  cart      Cart?
  addresses Address[]
  refreshToken RefreshToken[]
  @@index([createdAt])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   // đã hash
  userId     Int
  user       Users     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  revoked    Boolean  @default(false)
}

model Address {
  id         Int    @id @default(autoincrement())
  userId Int

  city       String
  district   String
  ward       String
  street     String

  customer   Users @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Categories {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  status      Int
  hot         Int

  createdAt   DateTime @default(now())
  updateAt    DateTime?

  products    Products[]

  @@index([status])
  @@index([hot])
}

model Products {
  id          Int    @id @default(autoincrement())

  categoryId  Int
  category    Categories @relation(fields: [categoryId], references: [id])

  name        String
  description String

  rate        Int
  countRate   Int
  purchases   Int

  createdAt   DateTime @default(now())
  updateAt    DateTime?

  productTypes ProductDetails[]
  comments     Comments[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([rate])
  @@index([purchases])

  // composite index (rất quan trọng)
  @@index([categoryId, createdAt])
  @@index([categoryId, purchases])
}

model ProductDetails {
  id        Int @id @default(autoincrement())

  productId Int
  color     Int
  size      Int
  price     Int

  status    Int

  createdAt DateTime @default(now())
  updateAt  DateTime?

  product   Products @relation(fields: [productId], references: [id])

  productStock ProductStock[]
  orderDetail  OrderDetails[]
  cartItems    CartItems[]

  @@unique([productId, size, color])
  @@index([productId])
}

model ProductStock {
  id              Int @id @default(autoincrement())

  productDetailId Int

  quantity        Int

  productDetail ProductDetails @relation(fields: [productDetailId], references: [id])
  // warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([productDetailId])
}

model Comments {
  id        Int @id @default(autoincrement())

  userId    Int
  productId Int

  content   String

  createdAt DateTime @default(now())
  updateAt  DateTime?

  user      Users @relation(fields: [userId], references: [id])
  product   Products  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
}

model Cart {
  id         Int @id @default(autoincrement())

  customerId Int @unique

  customer   Users @relation(fields: [customerId], references: [id])

  items      CartItems[]
}

model CartItems {
  id              Int @id @default(autoincrement())

  cartId          Int
  productDetailId Int
  quantity        Int

  cart          Cart           @relation(fields: [cartId], references: [id])
  productDetail ProductDetails @relation(fields: [productDetailId], references: [id])
  img           ImgCart[]

  @@unique([cartId, productDetailId])
  @@index([cartId])
}

model ImgCart {
  id              Int @id @default(autoincrement())
  cartItemId      Int
  cartItem        CartItems @relation(fields: [cartItemId], references: [id])
  img             String 
}

model Orders {
  id           Int @id @default(autoincrement())

  userId   Int
  status       Int
  totalPrice   Int

  createdAt    DateTime @default(now())

  customer     Users @relation(fields: [userId], references: [id])

  orderDetails OrderDetails[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model OrderDetails {
  id              Int @id @default(autoincrement())

  orderId         Int
  productDetailId Int

  quantity        Int
  price           Int

  order           Orders         @relation(fields: [orderId], references: [id])
  productDetail   ProductDetails @relation(fields: [productDetailId], references: [id])

  @@index([orderId])
  @@index([productDetailId])
}